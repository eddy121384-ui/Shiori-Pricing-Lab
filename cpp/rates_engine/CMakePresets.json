{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SHIORI_WARNINGS_AS_ERRORS": "ON",
        "SHIORI_BUILD_TESTS": "ON",
        "SHIORI_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "_vcpkg",
      "hidden": true,
      "inherits": "_common",
      "cacheVariables": {
        "SHIORI_DEPENDENCY_MODE": "VCPKG",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "_release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "_debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "_bench",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SHIORI_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "_msvc",
      "hidden": true,
      "inherits": "_vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "_linux-gcc",
      "hidden": true,
      "inherits": "_vcpkg",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-shiori-gcc",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "_linux-clang",
      "hidden": true,
      "inherits": "_vcpkg",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-shiori-clang",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "Windows MSVC x64 (Release)",
      "inherits": [
        "_msvc",
        "_release"
      ]
    },
    {
      "name": "msvc-debug",
      "displayName": "Windows MSVC x64 (Debug)",
      "inherits": [
        "_msvc",
        "_debug"
      ]
    },
    {
      "name": "msvc-bench",
      "displayName": "Windows MSVC x64 (benchmarks)",
      "inherits": [
        "_msvc",
        "_bench"
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "Linux GCC x64 (Release)",
      "inherits": [
        "_linux-gcc",
        "_release"
      ]
    },
    {
      "name": "gcc-debug",
      "displayName": "Linux GCC x64 (Debug)",
      "inherits": [
        "_linux-gcc",
        "_debug"
      ]
    },
    {
      "name": "gcc-bench",
      "displayName": "Linux GCC x64 (benchmarks)",
      "inherits": [
        "_linux-gcc",
        "_bench"
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Linux Clang x64 (Release)",
      "inherits": [
        "_linux-clang",
        "_release"
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "Linux Clang x64 (Debug)",
      "inherits": [
        "_linux-clang",
        "_debug"
      ]
    },
    {
      "name": "clang-bench",
      "displayName": "Linux Clang x64 (benchmarks)",
      "inherits": [
        "_linux-clang",
        "_bench"
      ]
    },
    {
      "name": "clang-sanitizers",
      "displayName": "Linux Clang x64 (ASan + UBSan, instrumented dependency closure)",
      "inherits": [
        "_linux-clang",
        "_debug"
      ],
      "cacheVariables": {
        "SHIORI_ENABLE_SANITIZERS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-shiori-asan"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Linux Clang x64 (ThreadSanitizer, instrumented dependency closure)",
      "inherits": [
        "_linux-clang",
        "_debug"
      ],
      "cacheVariables": {
        "SHIORI_ENABLE_TSAN": "ON",
        "SHIORI_ENABLE_SANITIZERS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-shiori-tsan"
      }
    },
    {
      "name": "gcc-fetchcontent-offline",
      "displayName": "Linux GCC x64 (FETCHCONTENT, fully disconnected)",
      "inherits": [
        "_common",
        "_release"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "SHIORI_DEPENDENCY_MODE": "FETCHCONTENT",
        "SHIORI_DEPENDENCY_OFFLINE": "ON",
        "SHIORI_FETCHCONTENT_FULLY_DISCONNECTED": "ON",
        "SHIORI_BOOST_ROOT": "$env{SHIORI_BOOST_ROOT}"
      }
    },
    {
      "name": "msvc-fetchcontent-offline",
      "displayName": "Windows MSVC x64 (FETCHCONTENT, fully disconnected)",
      "inherits": [
        "_common",
        "_release"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "SHIORI_DEPENDENCY_MODE": "FETCHCONTENT",
        "SHIORI_DEPENDENCY_OFFLINE": "ON",
        "SHIORI_FETCHCONTENT_FULLY_DISCONNECTED": "ON",
        "SHIORI_BOOST_ROOT": "$env{SHIORI_BOOST_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "_common-build",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "inherits": "_common-build"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "inherits": "_common-build"
    },
    {
      "name": "msvc-bench",
      "configurePreset": "msvc-bench",
      "inherits": "_common-build"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "inherits": "_common-build"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "inherits": "_common-build"
    },
    {
      "name": "gcc-bench",
      "configurePreset": "gcc-bench",
      "inherits": "_common-build"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "inherits": "_common-build"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "inherits": "_common-build"
    },
    {
      "name": "clang-bench",
      "configurePreset": "clang-bench",
      "inherits": "_common-build"
    },
    {
      "name": "clang-sanitizers",
      "configurePreset": "clang-sanitizers",
      "inherits": "_common-build"
    },
    {
      "name": "clang-tsan",
      "configurePreset": "clang-tsan",
      "inherits": "_common-build"
    }
  ],
  "testPresets": [
    {
      "name": "_common-test",
      "hidden": true,
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "timeout": 300
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "inherits": "_common-test"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "inherits": "_common-test"
    },
    {
      "name": "msvc-bench",
      "configurePreset": "msvc-bench",
      "inherits": "_common-test"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "inherits": "_common-test"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "inherits": "_common-test"
    },
    {
      "name": "gcc-bench",
      "configurePreset": "gcc-bench",
      "inherits": "_common-test"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "inherits": "_common-test"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "inherits": "_common-test"
    },
    {
      "name": "clang-bench",
      "configurePreset": "clang-bench",
      "inherits": "_common-test"
    },
    {
      "name": "clang-sanitizers",
      "configurePreset": "clang-sanitizers",
      "inherits": "_common-test",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:check_initialization_order=1:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "clang-tsan",
      "configurePreset": "clang-tsan",
      "inherits": "_common-test",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
