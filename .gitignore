# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.env
.env.*

# Build artifacts
build/
dist/
*.egg-info/

# C++ Rates Engine (Issue #227): CMakePresets is the only configuration authority and every preset
# places its tree under cpp/rates_engine/build/<preset>/. Generated headers and vcpkg material are
# never committed. Stated explicitly so the C++ tree's build output path cannot be mistaken for a
# source directory.
/cpp/rates_engine/build/

# C++ Rates Engine CI provisioning (Issue #227; .github/workflows/cpp-rates-engine.yml). The workflow
# materializes the pinned vcpkg checkout and its binary caches INSIDE $GITHUB_WORKSPACE, so these root
# directories are untracked build provisioning, never source. cmake/ShioriBuildIdentity.cmake derives
# the reported source identity from `git status --porcelain`, so without these rules every clean CI
# artifact was stamped `<sha>-dirty` and was indistinguishable from a genuinely modified checkout.
# The list is exact and root-anchored: any other untracked file still labels the tree dirty.
/.vcpkg-root/
/.vcpkg-root-asan/
/.vcpkg-root-tsan/
/.vcpkg-root-bench/
/.vcpkg-cache/
/.vcpkg-cache-asan/
/.vcpkg-cache-tsan/
/.vcpkg-cache-bench/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local data and secrets
# /data/ also holds the canonical vol-surface SQLite store (Issue #183,
# data/vol_surfaces.sqlite3). It is runtime state built from operator
# screenshots and must never be committed.
/data/
/cache/
*.db
*.sqlite
*.sqlite3
*.parquet
*.csv.local
secrets.*
credentials.*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Local Bloomberg probe evidence (tools/bloomberg_input_sourcing_probe.py)
/shiori_probe_output/

# Local Bloomberg historical bond-Yield evidence (Issue #196):
# tools/bloomberg_bond_yield_field_probe.py and
# tools/bloomberg_bond_yield_history_acceptance.py write their reports here.
# The reports carry no Bloomberg values by construction, but the directories
# are runtime workstation evidence and are never committed.
/shiori_bond_yield_field_probe_output/
/shiori_bond_yield_history_acceptance_output/
